<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Imc.Maui.Views.MainPage"
             Title="Indice de masa corporal">
    <VerticalStackLayout
        Padding="24"
        Spacing="24">
        
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="Propocione el peso en kilogramos"/>
                <Entry
                    Text="{Binding Path=Peso}"
                    BackgroundColor="WhiteSmoke"/>
                <Label
                    Text="Proporcione la estatura en metros"/>
                <Entry
                    Text="{Binding Path=Estatura}"
                    BackgroundColor="WhiteSmoke"/>
            </VerticalStackLayout>
        </Border>
            
        <HorizontalStackLayout
            Spacing="24"
            HorizontalOptions="Center">
            <Button
                Text="Calcular"
                Command="{Binding Path=CalcularCommand}"
                BackgroundColor="Green"/>
            <Button
                Text="Limpiar"
                Command="{Binding Path=LimpiarCommand}"/>
        </HorizontalStackLayout>
            
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="El indice de masa corporal de la persona es:"/>
                <Label
                    Text="{Binding Path=Imc}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>
                <Label
                    Text="El estado nutricional de la persona es:"/>
                <Label
                    Text="{Binding Path=EstadoNutricional}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
    
</ContentPage>